# Sahil Pay — Flask API via gunicorn
# Install: sudo cp deploy/systemd/*.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now sahilpay
[Unit]
Description=Sahil Pay API (gunicorn)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
User=sahilpay
Group=sahilpay
WorkingDirectory=/var/www/sahilpay/app/server
EnvironmentFile=/var/www/sahilpay/app/server/.env
Environment=APP_ENV=production
ExecStart=/var/www/sahilpay/app/server/venv/bin/gunicorn "app:create_app()" \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
