# =============================================================================
# Sahil Pay — PRODUCTION server environment  (copy to /var/www/sahilpay/server/.env)
# =============================================================================
# Every var marked REQUIRED is enforced by ProductionConfig._validate() —
# the app refuses to boot without it. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Core (REQUIRED) ---
APP_ENV=production
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM
JWT_SECRET_KEY=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM

# --- Database (REQUIRED) — local PostgreSQL on the VPS ---
DATABASE_URL=postgresql+psycopg2://sahilpay:REPLACE_DB_PASSWORD@localhost:5432/sahilpay

# --- Redis (REQUIRED) — Celery broker + rate limiter, local on the VPS ---
REDIS_URL=redis://localhost:6379/0

# --- Domain / CORS ---
FRONTEND_URL=https://sahilpay.co.ke
CORS_ORIGINS=https://sahilpay.co.ke,https://www.sahilpay.co.ke

# --- Email — SendGrid (REQUIRED). Domain sahilpay.co.ke is already
#     authenticated in SendGrid, so any @sahilpay.co.ke sender works. ---
SENDGRID_API_KEY=SG.REPLACE
# noreply@ = the "From" on all app mail (OTPs, reports, verifications). The
# hello@ contact address users SEE is set in code (branding.py), not here.
MAIL_DEFAULT_SENDER=noreply@sahilpay.co.ke
MAIL_DEFAULT_SENDER_NAME=SahilPay
ENFORCE_EMAIL_VERIFICATION=true
# MUST be false in production so real OTPs / emails / SMS actually send.
COMMS_SIMULATION_MODE=false

# --- File / image storage (OPTIONAL for v1) ---
# If these are left blank the app stores uploaded documents/receipts on LOCAL
# DISK (server/uploads/, served by /uploads) — verified working. Back that
# folder up (see runbook). Set an S3-compatible provider later (AWS S3, or
# Cloudflare R2 / Backblaze B2 via S3_ENDPOINT_URL) with NO code change.
# S3_BUCKET=sahilpay-documents
# S3_REGION=auto
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# Cloudinary (property images) is currently unused by the app — leave blank.
# CLOUDINARY_CLOUD_NAME=

# --- FluxSMS — SMS delivery ---
FLUXSMS_BASE_URL=https://api.fluxsms.co.ke
FLUXSMS_API_KEY=REPLACE
FLUXSMS_SENDER_ID=SAHILPAY

# --- M-Pesa Daraja — PLATFORM paybill (REQUIRED). PRODUCTION values. ---
# C2B URLs are ALREADY REGISTERED against https://sahilpay.co.ke — do not
# re-register. See MPESA_INTEGRATION_SPEC.md.
DARAJA_BASE_URL=https://api.safaricom.co.ke
PLATFORM_DARAJA_CONSUMER_KEY=REPLACE
PLATFORM_DARAJA_CONSUMER_SECRET=REPLACE
PLATFORM_DARAJA_SHORTCODE=REPLACE
PLATFORM_DARAJA_PASSKEY=REPLACE
PLATFORM_DARAJA_STK_CALLBACK_URL=https://sahilpay.co.ke/api/webhooks/daraja/billing-callback
# Keep true until the Daraja production passkey + initiator credentials are in
# hand; true lets the app boot without PLATFORM_DARAJA_PASSKEY.
MPESA_SIMULATION_MODE=true
