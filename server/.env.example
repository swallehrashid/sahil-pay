# ============================================================================
# SahilPay — server environment (.env.example)
# ----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. In PRODUCTION (APP_ENV=production),
# the app REFUSES TO BOOT unless every var in the "REQUIRED IN PRODUCTION"
# block below is set. Everything else falls back to a sensible default in
# config.py. Never commit the real .env.
# ============================================================================

# --- Environment selector -------------------------------------------------
# development | testing | production. MUST be "production" on the VPS.
APP_ENV=production

# ============================================================================
# REQUIRED IN PRODUCTION — the app raises on startup if any of these is missing
# ============================================================================

# Flask session/crypto secret. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# JWT signing key (separate from SECRET_KEY). Generate the same way.
JWT_SECRET_KEY=

# PostgreSQL. Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://sahilpay:CHANGE_ME@localhost:5432/sahilpay_prod

# Redis — Celery broker/result backend AND the rate-limiter store.
REDIS_URL=redis://localhost:6379/0

# SendGrid API key (Mail Send scope). Domain sahilpay.co.ke is already
# authenticated in SendGrid, so any @sahilpay.co.ke sender works.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx

# M-Pesa Daraja — platform paybill (subscriptions, SMS credits, affiliate
# payouts ONLY; tenant rent never flows through this shortcode).
PLATFORM_DARAJA_CONSUMER_KEY=your-daraja-consumer-key
# Required additionally when MPESA_SIMULATION_MODE=false (real STK push):
PLATFORM_DARAJA_PASSKEY=your-daraja-passkey

# ============================================================================
# EMAIL — addresses (two DIFFERENT addresses, on purpose)
# ============================================================================
# The "From" on every APP email (OTPs, reports, verifications, instructions).
# This is the no-reply sender. Users are NOT meant to reply here.
MAIL_DEFAULT_SENDER=noreply@sahilpay.co.ke
MAIL_DEFAULT_SENDER_NAME=SahilPay
# (The contact address users SEE and write to — hello@sahilpay.co.ke — is set
#  in code: services/branding.py + config.py. No env var needed for it.)

# When true, message dispatch is SIMULATED (logged, not sent). MUST be false
# in production for real OTPs/emails/SMS to go out.
COMMS_SIMULATION_MODE=false

# When true, landlords must verify their email before they can log in.
ENFORCE_EMAIL_VERIFICATION=true

# ============================================================================
# SMS — FluxSMS (sender ID SAHILPAY)
# ============================================================================
FLUXSMS_API_KEY=your-fluxsms-api-key
FLUXSMS_SENDER_ID=SAHILPAY
FLUXSMS_BASE_URL=https://api.fluxsms.co.ke

# ============================================================================
# FRONTEND / CORS — single-origin deployment on sahilpay.co.ke
# ============================================================================
# Comma-separated origins allowed to call /api/*. Since the React build is
# served from the same domain, this is just the production domain.
CORS_ORIGINS=https://sahilpay.co.ke,https://www.sahilpay.co.ke
# Base URL used to build links inside emails.
FRONTEND_URL=https://sahilpay.co.ke

# ============================================================================
# M-Pesa Daraja — the rest of the platform paybill config
# ============================================================================
PLATFORM_DARAJA_CONSUMER_SECRET=your-daraja-consumer-secret
PLATFORM_DARAJA_SHORTCODE=your-paybill-number

# Callback URL Daraja calls after an STK Push. NOTE: Safaricom REJECTS any
# callback URL containing "mpesa"/"safaricom" — use "daraja" in the path.
PLATFORM_DARAJA_STK_CALLBACK_URL=https://sahilpay.co.ke/api/webhooks/daraja/billing-callback

# B2C (affiliate payouts).
PLATFORM_DARAJA_INITIATOR_NAME=your-b2c-initiator-name
PLATFORM_DARAJA_SECURITY_CREDENTIAL=your-encrypted-security-credential

# CIDR ranges allowed to hit /api/webhooks/daraja/* (Safaricom's callback IPs).
DARAJA_ALLOWED_IPS=196.201.212.0/24,196.201.213.0/24,196.201.214.0/24
# true behind nginx (which sets X-Forwarded-For). Needed for DARAJA_ALLOWED_IPS + rate-limits.
TRUST_PROXY=true

# false = real Daraja calls. true = everything simulated (no external calls).
MPESA_SIMULATION_MODE=false
DARAJA_BASE_URL=https://api.safaricom.co.ke

# ============================================================================
# OPTIONAL — cloud file storage. If UNSET, uploaded documents/receipts are
# stored on local disk under server/uploads/ (served by /uploads). Fine for
# v1; back up that folder. Set these later to move storage off the VPS with
# NO code change (S3, or S3-compatible like Cloudflare R2 / Backblaze B2 via
# S3_ENDPOINT_URL).
# ============================================================================
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=            # set for R2/B2; leave blank for AWS
# S3_PUBLIC_BASE_URL=         # CDN/public URL prefix if the bucket is fronted

# Cloudinary (property/maintenance images) — currently unused by the app; safe to leave blank.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
