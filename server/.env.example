# ============================================================================
# SahilPay — server environment variables (example)
# Copy the values you need into a real `.env` file in this folder. Anything not
# set here falls back to the defaults in config.py.
# ============================================================================

# --- Core ---
# APP_ENV=development            # development | testing | production
# SECRET_KEY=change-me
# DATABASE_URL=postgresql://user:pass@localhost:5432/sahilpay

# --- Frontend base URL (used to build links inside emails) ---
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Email — SendGrid (transactional: OTP, verification, password reset, team invites)
# ============================================================================
# Get the API key from SendGrid -> Settings -> API Keys -> Create API Key (Full
# Access, or Restricted with "Mail Send" enabled). It is shown ONCE — copy it now.
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx

# The "From" address every email is sent as. It MUST be verified in SendGrid
# (Settings -> Sender Authentication -> Single Sender Verification) or sends fail.
MAIL_DEFAULT_SENDER=innit819@gmail.com
MAIL_DEFAULT_SENDER_NAME=SahilPay

# When true, landlords must verify their email before they can log in.
# Defaults to false in development so you aren't locked out before SendGrid is wired.
# Set to true once email works to enable the gated flow.
ENFORCE_EMAIL_VERIFICATION=false
